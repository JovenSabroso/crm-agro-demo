# Copia a .env (NO subir .env al repositorio)
NODE_ENV=development
PORT=4000
DB_PATH=./data/crm-agro.db
# Obligatorio en produccion (>= 32 caracteres aleatorios)
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base de las URLs que codifican los QR (ficha publica /t/<codigo>)
PUBLIC_BASE_URL=http://localhost:5173
ALLOW_REGISTRATION=true
# Solo desarrollo: devuelve el token de recuperacion en la respuesta
EXPOSE_RESET_TOKEN=true
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=20
RIEGO_ALERTA_DIAS=7

# ---- Integraciones FUTURAS (desactivadas; ver backend/src/integrations/README.md) ----
WHATSAPP_PROVIDER=cloud-api
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# ---- WhatsApp + Gemini (módulo src/whatsapp) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3.5-flash
MODO_IA=clasificar
STORAGE_DIR=./storage
