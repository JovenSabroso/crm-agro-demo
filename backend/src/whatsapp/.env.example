# Generado: 25/11/2026 05:40
# Copia este archivo a .env y completa los valores EN EL SERVIDOR. Nunca subas el .env a Git ni lo pegues en un chat.

# --- Servidor web interno (solo para /salud y /qr). Escucha SOLO en localhost; nginx lo publica con HTTPS.
HOST=127.0.0.1
PORT=3101
# Protege /qr y /salud. Generar con:  openssl rand -hex 32   (mínimo 24 caracteres)
ADMIN_TOKEN=

# --- Gemini (Google AI Studio). Varias claves separadas por coma, SIN espacios,
# cada una de un proyecto distinto (la cuota es por proyecto y por modelo).
GEMINI_API_KEY=
# Modelo principal y respaldos. Los nombres caducan: revisa la lista con la guía (sección 6).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3.5-flash
# "clasificar": Gemini solo entiende la intención (lo más seguro).
# "responder": además contesta preguntas libres usando SOLO datos/negocio.json.
MODO_IA=clasificar

# --- Comportamiento de WhatsApp
REPLY_DELAY_MIN_MS=4000
REPLY_DELAY_MAX_MS=9000
BATCH_WINDOW_MS=5000
BATCH_MAX_WAIT_MS=30000
MAX_SENDS_PER_MINUTE=20
MAX_RECONNECT_ATTEMPTS=8
SESSION_MINUTES=30
HUMAN_PAUSE_HOURS=8
OPTOUT_KEYWORDS=baja,stop,no quiero recibir mensajes
# Carpeta de credenciales y estado (fuera de public/, ignorada por Git).
STORAGE_DIR=./storage
LOG_LEVEL=info
